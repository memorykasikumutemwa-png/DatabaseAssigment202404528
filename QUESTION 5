CREATE TABLE students (
  student_id SERIAL PRIMARY KEY,
  student_number VARCHAR(20) UNIQUE NOT NULL,
  full_name VARCHAR(100) NOT NULL
);
CREATE TABLE rooms (
  room_id SERIAL PRIMARY KEY,
  room_number VARCHAR(20) UNIQUE NOT NULL,
  capacity INTEGER NOT NULL CHECK (capacity > 0)
);
CREATE TABLE allocations (
  allocation_id SERIAL PRIMARY KEY,
  student_id INTEGER NOT NULL REFERENCES students(student_id),
  room_id INTEGER NOT NULL REFERENCES rooms(room_id),
  allocated_on DATE NOT NULL,
  released_on DATE,
  status VARCHAR(10) NOT NULL CHECK (status IN ('ACTIVE','ENDED')),
  CHECK ((status = 'ACTIVE' AND released_on IS NULL)
      OR (status = 'ENDED' AND released_on IS NOT NULL))
);
CREATE TABLE occupancy_snapshot (
  snapshot_date DATE NOT NULL,
  room_id INTEGER NOT NULL REFERENCES rooms(room_id),
  occupied_beds INTEGER NOT NULL,
  free_beds INTEGER NOT NULL,
  PRIMARY KEY (snapshot_date, room_id)
);
CREATE UNIQUE INDEX uq_one_active_student
ON allocations(student_id) WHERE status = 'ACTIVE';

