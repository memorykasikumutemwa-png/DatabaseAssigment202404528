CREATE OR REPLACE FUNCTION fn_scholarship_eligible(
  p_age INTEGER, p_income NUMERIC, p_mark NUMERIC
) RETURNS BOOLEAN LANGUAGE plpgsql AS $$
BEGIN
  IF p_age IS NULL OR p_income IS NULL OR p_mark IS NULL
     OR p_age <= 0 OR p_income < 0 OR p_mark < 0 OR p_mark > 100 THEN
    RAISE EXCEPTION 'Invalid scholarship assessment values';
  END IF;
  RETURN p_age BETWEEN 18 AND 25 AND p_income <= 3000 AND p_mark >= 70;
END; $$;

CREATE OR REPLACE PROCEDURE pr_assess_application(p_application_id INTEGER)
LANGUAGE plpgsql AS $$
DECLARE v_age INTEGER; v_income NUMERIC(12,2); v_mark NUMERIC(5,2);
        v_status VARCHAR(10); v_eligible BOOLEAN;
BEGIN
  SELECT age_at_application, monthly_income, average_mark, status
  INTO v_age, v_income, v_mark, v_status
  FROM applications WHERE application_id = p_application_id FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'Unknown scholarship application'; END IF;
  IF v_status <> 'PENDING' THEN RAISE EXCEPTION 'Application has already been assessed'; END IF;
  v_eligible := fn_scholarship_eligible(v_age, v_income, v_mark);
  UPDATE applications
  SET status = CASE WHEN v_eligible THEN 'APPROVED' ELSE 'REJECTED' END
  WHERE application_id = p_application_id;
END; $$;

CREATE OR REPLACE FUNCTION fn_decision_audit()
RETURNS TRIGGER LANGUAGE plpgsql AS $$
BEGIN
  IF OLD.status IS DISTINCT FROM NEW.status THEN
    INSERT INTO decision_audit(application_id, old_status, new_status)
    VALUES (NEW.application_id, OLD.status, NEW.status);
  END IF;
  RETURN NEW;
END; $$;
CREATE TRIGGER trg_decision_audit
AFTER UPDATE ON applications FOR EACH ROW EXECUTE FUNCTION fn_decision_audit();

-- Assess the six sample applications through the procedure.
DO $$
DECLARE r RECORD;
BEGIN
  FOR r IN SELECT application_id FROM applications WHERE status = 'PENDING'
  LOOP
    CALL pr_assess_application(r.application_id);
  END LOOP;
END; $$;

CREATE OR REPLACE VIEW v_approved_applicants AS
SELECT s.student_number, s.full_name, a.average_mark, a.status
FROM applications a JOIN students s ON s.student_id = a.student_id
WHERE a.status = 'APPROVED';
SELECT * FROM v_approved_applicants;

CREATE INDEX idx_applications_status_date ON applications(status, submitted_on);
EXPLAIN SELECT * FROM applications
WHERE status = 'PENDING'
  AND submitted_on BETWEEN CURRENT_DATE - 30 AND CURRENT_DATE;

CREATE OR REPLACE PROCEDURE pr_assess_pending()
LANGUAGE plpgsql AS $$
DECLARE r RECORD;
BEGIN
  FOR r IN SELECT application_id FROM applications WHERE status = 'PENDING'
  LOOP
    CALL pr_assess_application(r.application_id);
  END LOOP;
END; $$;

CREATE EXTENSION IF NOT EXISTS pg_cron;
SELECT cron.schedule('weekly-scholarship-assessment', '0 8 * * 1',
