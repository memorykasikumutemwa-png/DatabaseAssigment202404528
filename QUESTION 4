CREATE OR REPLACE FUNCTION fn_daily_load(p_doctor_id INTEGER, p_day DATE)
RETURNS INTEGER LANGUAGE plpgsql AS $$
DECLARE v_count INTEGER;
BEGIN
  IF NOT EXISTS (SELECT 1 FROM doctors WHERE doctor_id = p_doctor_id) THEN
    RAISE EXCEPTION 'Unknown doctor';
  END IF;
  SELECT COUNT(*) INTO v_count FROM appointments
  WHERE doctor_id = p_doctor_id AND appointment_day = p_day
    AND status <> 'CANCELLED';
  RETURN v_count;
END; $$;

CREATE OR REPLACE PROCEDURE pr_book_appointment(
  p_patient_id INTEGER, p_doctor_id INTEGER, p_day DATE, p_slot TIME
) LANGUAGE plpgsql AS $$
BEGIN
  IF p_patient_id IS NULL OR p_doctor_id IS NULL OR p_day IS NULL OR p_slot IS NULL THEN
    RAISE EXCEPTION 'All appointment details are required';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM patients WHERE patient_id = p_patient_id) THEN
    RAISE EXCEPTION 'Unknown patient';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM doctors WHERE doctor_id = p_doctor_id) THEN
    RAISE EXCEPTION 'Unknown doctor';
  END IF;
  IF p_day < CURRENT_DATE THEN RAISE EXCEPTION 'Past appointment date is not allowed'; END IF;
  IF p_slot NOT IN (TIME '09:00',TIME '10:00',TIME '11:00',TIME '12:00') THEN
    RAISE EXCEPTION 'Unsupported appointment slot';
  END IF;
  INSERT INTO appointments(patient_id, doctor_id, appointment_day, slot_time, status)
  VALUES (p_patient_id, p_doctor_id, p_day, p_slot, 'BOOKED');
END; $$;

CREATE OR REPLACE FUNCTION fn_check_appointment_clash()
RETURNS TRIGGER LANGUAGE plpgsql AS $$
BEGIN
  IF NEW.status <> 'CANCELLED' AND EXISTS (
    SELECT 1 FROM appointments a
    WHERE a.doctor_id = NEW.doctor_id
      AND a.appointment_day = NEW.appointment_day
      AND a.slot_time = NEW.slot_time
      AND a.status <> 'CANCELLED'
      AND (TG_OP = 'INSERT' OR a.appointment_id <> NEW.appointment_id)
  ) THEN
    RAISE EXCEPTION 'Doctor slot is already occupied';
  END IF;
  RETURN NEW;
END; $$;
CREATE TRIGGER trg_check_appointment_clash
BEFORE INSERT OR UPDATE ON appointments
FOR EACH ROW EXECUTE FUNCTION fn_check_appointment_clash();

CREATE OR REPLACE VIEW v_today_appointments AS
SELECT p.full_name AS patient_name, d.full_name AS doctor_name, a.slot_time
FROM appointments a
JOIN patients p ON p.patient_id = a.patient_id
JOIN doctors d ON d.doctor_id = a.doctor_id
WHERE a.appointment_day = CURRENT_DATE AND a.status = 'BOOKED';
