CREATE OR REPLACE FUNCTION fn_free_beds(p_room_id INTEGER)
RETURNS INTEGER LANGUAGE plpgsql AS $$
DECLARE v_capacity INTEGER; v_occupied INTEGER;
BEGIN
  SELECT capacity INTO v_capacity FROM rooms WHERE room_id = p_room_id;
  IF NOT FOUND THEN RAISE EXCEPTION 'Unknown room'; END IF;
  SELECT COUNT(*) INTO v_occupied FROM allocations
  WHERE room_id = p_room_id AND status = 'ACTIVE';
  RETURN v_capacity - v_occupied;
END; $$;

CREATE OR REPLACE PROCEDURE pr_allocate_room(
  p_student_id INTEGER, p_room_id INTEGER, p_allocated_on DATE
) LANGUAGE plpgsql AS $$
BEGIN
  IF p_allocated_on IS NULL THEN RAISE EXCEPTION 'Allocation date is required'; END IF;
  IF NOT EXISTS (SELECT 1 FROM students WHERE student_id = p_student_id) THEN
    RAISE EXCEPTION 'Unknown student';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM rooms WHERE room_id = p_room_id) THEN
    RAISE EXCEPTION 'Unknown room';
  END IF;
  IF EXISTS (SELECT 1 FROM allocations WHERE student_id = p_student_id AND status = 'ACTIVE') THEN
    RAISE EXCEPTION 'Student already has an active allocation';
  END IF;
  PERFORM 1 FROM rooms WHERE room_id = p_room_id FOR UPDATE;
  IF fn_free_beds(p_room_id) <= 0 THEN RAISE EXCEPTION 'Room is full'; END IF;
  INSERT INTO allocations(student_id, room_id, allocated_on, released_on, status)
  VALUES (p_student_id, p_room_id, p_allocated_on, NULL, 'ACTIVE');
END; $$;

CREATE OR REPLACE FUNCTION fn_validate_allocation()
RETURNS TRIGGER LANGUAGE plpgsql AS $$
DECLARE v_capacity INTEGER; v_count INTEGER;
BEGIN
  IF NEW.status = 'ACTIVE' THEN
    PERFORM 1 FROM rooms WHERE room_id = NEW.room_id FOR UPDATE;
    SELECT capacity INTO v_capacity FROM rooms WHERE room_id = NEW.room_id;
    IF NOT FOUND THEN RAISE EXCEPTION 'Unknown room'; END IF;
    SELECT COUNT(*) INTO v_count FROM allocations a
    WHERE a.room_id = NEW.room_id AND a.status = 'ACTIVE'
      AND (TG_OP = 'INSERT' OR a.allocation_id <> NEW.allocation_id);
    IF v_count >= v_capacity THEN RAISE EXCEPTION 'Room capacity exceeded'; END IF;
    IF EXISTS (
      SELECT 1 FROM allocations a
      WHERE a.student_id = NEW.student_id AND a.status = 'ACTIVE'
        AND (TG_OP = 'INSERT' OR a.allocation_id <> NEW.allocation_id)
    ) THEN RAISE EXCEPTION 'Student already has an active allocation'; END IF;
    NEW.released_on := NULL;
  ELSIF NEW.status = 'ENDED' AND NEW.released_on IS NULL THEN
    RAISE EXCEPTION 'Release date is required for ENDED allocation';
  END IF;
  RETURN NEW;
END; $$;
CREATE TRIGGER trg_validate_allocation
BEFORE INSERT OR UPDATE ON allocations
FOR EACH ROW EXECUTE FUNCTION fn_validate_allocation();

CREATE OR REPLACE VIEW v_room_occupancy AS
SELECT r.room_number, r.capacity,
       COUNT(a.allocation_id) FILTER (WHERE a.status = 'ACTIVE') AS occupied_beds,
       r.capacity - COUNT(a.allocation_id) FILTER (WHERE a.status = 'ACTIVE') AS free_beds
FROM rooms r LEFT JOIN allocations a ON a.room_id = r.room_id
GROUP BY r.room_id, r.room_number, r.capacity;
SELECT * FROM v_room_occupancy;

CREATE INDEX idx_active_allocations_room ON allocations(room_id) WHERE status = 'ACTIVE';
EXPLAIN SELECT * FROM allocations WHERE room_id = 1 AND status = 'ACTIVE';

CREATE OR REPLACE PROCEDURE pr_refresh_occupancy()
LANGUAGE plpgsql AS $$
BEGIN
  INSERT INTO occupancy_snapshot(snapshot_date, room_id, occupied_beds, free_beds)
  SELECT CURRENT_DATE, r.room_id,
         COUNT(a.allocation_id) FILTER (WHERE a.status = 'ACTIVE'),
         r.capacity - COUNT(a.allocation_id) FILTER (WHERE a.status = 'ACTIVE')
  FROM rooms r LEFT JOIN allocations a ON a.room_id = r.room_id
  GROUP BY r.room_id, r.capacity
  ON CONFLICT (snapshot_date, room_id) DO UPDATE
  SET occupied_beds = EXCLUDED.occupied_beds,
      free_beds = EXCLUDED.free_beds;
END; $$;

CREATE EXTENSION IF NOT EXISTS pg_cron;
SELECT cron.schedule('daily-occupancy-refresh', '55 23 * * *',
                     'CALL pr_refresh_occupancy()');
