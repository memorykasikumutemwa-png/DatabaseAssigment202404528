CREATE TABLE patients (
  patient_id SERIAL PRIMARY KEY,
  full_name VARCHAR(100) NOT NULL
);
CREATE TABLE doctors (
  doctor_id SERIAL PRIMARY KEY,
  full_name VARCHAR(100) NOT NULL
);
CREATE TABLE appointments (
  appointment_id SERIAL PRIMARY KEY,
  patient_id INTEGER NOT NULL REFERENCES patients(patient_id),
  doctor_id INTEGER NOT NULL REFERENCES doctors(doctor_id),
  appointment_day DATE NOT NULL,
  slot_time TIME NOT NULL CHECK (slot_time IN
    (TIME '09:00', TIME '10:00', TIME '11:00', TIME '12:00')),
  status VARCHAR(10) NOT NULL CHECK (status IN ('BOOKED','ATTENDED','CANCELLED'))
);
CREATE TABLE clinic_summary (
  summary_date DATE PRIMARY KEY,
  booked_count INTEGER NOT NULL,
  attended_count INTEGER NOT NULL,
  cancelled_count INTEGER NOT NULL
);
CREATE UNIQUE INDEX uq_doctor_slot_active
ON appointments(doctor_id, appointment_day, slot_time)
WHERE status <> 'CANCELLED';

